.env


```gitignore
# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# ==========================
# Virtual Environment
# ==========================
venv/
.venv/
env/
ENV/

# ==========================
# Downloaded Files
# ==========================
app/downloads/
downloads/

# Ignore downloaded Excel/CSV files
*.xlsx
*.xls
*.csv

# ==========================
# Logs
# ==========================
*.log
logs/

# ==========================
# IDE / Editor
# ==========================
.vscode/
.idea/

# ==========================
# Operating System Files
# ==========================
.DS_Store
Thumbs.db


# ==========================
# Pytest / Coverage
# ==========================
.pytest_cache/
.coverage
htmlcov/

# ==========================
# Build Artifacts
# ==========================
build/
dist/
*.egg-info/

# ==========================
# Jupyter
# ==========================
.ipynb_checkpoints/
```
